# Dependencies
node_modules/

# Build output
dist/
out/
# (build/* rather than build/ so the entitlements re-include below can work —
# git cannot re-include a file inside a fully excluded directory)
build/*
# Keep the electron-builder mac entitlements (referenced by package.json;
# the release CI build fails without it)
!build/entitlements.mac.plist

# Electron packaged apps
*.dmg
*.exe
*.AppImage
*.snap
*.deb
*.rpm
*.zip
*.tar.gz

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/
*.log
npm-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local
aws-credentials
credentials.json

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Photoshop source files (binary, large)
*.psd
