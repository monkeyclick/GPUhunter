{
  "name": "gpu-hunter",
  "version": "0.1.0",
  "description": "Find GPU instance capacity across AWS and GCP — regions, AZs, and live probing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monkeyclick/GPUhunter.git"
  },
  "main": "main.js",
  "bin": {
    "gpuhunter": "cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "cli.js",
    "aws.js",
    "gcp.js",
    "core/",
    "renderer/catalog.js",
    "renderer/format.js",
    "renderer/package.json"
  ],
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "scan": "node cli.js scan",
    "test": "node --test",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.gpuhunter.app",
    "productName": "GPU Hunter",
    "copyright": "Copyright © 2025",
    "icon": "renderer/gpulogo.png",
    "files": [
      "main.js",
      "aws.js",
      "gcp.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      "!renderer/gpulogo.psd"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "monkeyclick",
      "repo": "GPUhunter"
    }
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.600.0",
    "@aws-sdk/credential-providers": "^3.600.0",
    "@google-cloud/compute": "^6.11.0",
    "electron-updater": "^6.3.0",
    "google-auth-library": "^10.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "electron": "^42.5.2",
    "electron-builder": "^26.15.3",
    "leaflet": "^1.9.4"
  }
}
